Date: Tue, 5 Nov 2019 13:47:40 -0600
Subject: [PATCH] DtsUltra: Allow DtsUltra to work outside of stock

* Taken from https://forum.xda-developers.com/android/software/port-dtsx-ultra-dts-headphonex-t3896233/post78817768

Change-Id: I91d070039be0f374eb78e3f4248737a7c9a72703
Signed-off-by: anrui2032 <anrui2032@gmail.com>
---
 AndroidManifest.xml                  |   4 +-
 .../android/media/audiofx/DtsAudio.smali      | 117 ++++++++++++++++++
 smali/c/b/a/b.smali                  |   2 +-
 3 files changed, 121 insertions(+), 2 deletions(-)
 create mode 100644 smali/android/media/audiofx/DtsAudio.smali

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index 4449408..43a1dd7 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -7,9 +7,11 @@
     <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
     <uses-permission android:name="android.permission.BLUETOOTH"/>
     <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
+    <uses-permission android:name="android.permission.MODIFY_DEFAULT_AUDIO_EFFECTS"/>
     <permission android:description="@string/dts_permission_effect_description" android:label="@string/dts_permission_effect_title" android:name="com.dts.permission.DTS_EFFECT" android:protectionLevel="normal"/>
     <uses-permission android:name="com.dts.permission.DTS_EFFECT"/>
     <application android:allowBackup="true" android:appComponentFactory="androidx.core.app.CoreComponentFactory" android:icon="@mipmap/dts_dtsx_icon" android:label="@string/app_name" android:theme="@style/AppTheme">
+        <uses-library android:name="android.media.audiofx" android:required="true"/>
         <activity android:configChanges="orientation|screenLayout|screenSize" android:label="@string/app_short_name" android:launchMode="singleTask" android:name="com.dts.dtsxultra.activities.MainActivity" android:screenOrientation="user" android:theme="@style/AppTheme"/>
         <activity android:label="@string/app_short_name" android:launchMode="singleTask" android:name="com.dts.dtsxultra.activities.ListeningProfileActivity"/>
         <activity android:configChanges="orientation|screenLayout|screenSize" android:exported="true" android:label="@string/app_short_name" android:name="com.dts.dtsxultra.activities.SplashActivity" android:screenOrientation="user">
@@ -18,7 +20,7 @@
                 <category android:name="android.intent.category.LAUNCHER"/>
             </intent-filter>
             <intent-filter>
-                <action android:name="android.intent.zte.dts"/>
+                <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL"/>
                 <category android:name="android.intent.category.DEFAULT"/>
             </intent-filter>
         </activity>
