binder_call(cameraserver, hal_face_default)
binder_call(hal_face_default, cameraserver)
binder_call(hal_face_default, system_server)
binder_call(system_server, hal_face_default)

hal_client_domain(hal_face_default, hal_graphics_allocator)

get_prop(hal_face_default, bootloader_prop)
get_prop(hal_face_default, camera_config_prop)
allow hal_face_default surfaceflinger:fd use;
allow hal_face_default cameraserver_service:service_manager find;
allow hal_face_default fwk_camera_service:service_manager find;
allow hal_face_default vendor_data_file:dir search;
allow hal_face_default vendor_face_data_file:dir create_dir_perms;
allow hal_face_default vendor_face_data_file:file create_file_perms;
