type camerahalvs, domain;
type camerahalvs_exec, exec_type, vendor_file_type, file_type;

get_prop(camerahalvs, graphics_config_prop)
get_prop(camerahalvs, graphics_config_writable_prop)
get_prop(camerahalvs, hwservicemanager_prop)
get_prop(camerahalvs, zygote_config_prop)

hal_client_domain(camerahalvs, hal_configstore)
hal_client_domain(camerahalvs, hal_graphics_allocator)
hal_client_domain(camerahalvs, vendor_hal_qspmhal)

hwbinder_use(camerahalvs)
vndbinder_use(camerahalvs)

init_daemon_domain(camerahalvs)

set_prop(camerahalvs, chvsfirstboot_prop)

allow camerahalvs gpu_device:chr_file rw_file_perms;
allow camerahalvs ion_device:chr_file r_file_perms;
allow camerahalvs vendor_camera_data_file:dir create_dir_perms;
allow camerahalvs vendor_camera_data_file:file create_file_perms;
